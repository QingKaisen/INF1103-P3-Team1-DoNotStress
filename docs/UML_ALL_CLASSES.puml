  + revoke_admin()
  + clear_pending()
  + matched_pending_id(fingerprint)
  + remember_submission(fingerprint, record_id, pending_save)
  + current_entry()
  + expire_records_and_check_csrf()
  + render_campus(page)
  + checkin()
  + retired_page()
  + admin_login()
  + admin_logout()
  + submit_checkin()
  + records_page()
  + saved_records()
  + records_summary()
  + result()
  + save_checkin()
  + new_checkin()
  + oversized_request(error)
  + prevent_answer_caching(response)
}
