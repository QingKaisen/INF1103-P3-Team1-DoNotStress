digraph DFD {
  graph [rankdir=LR, dpi=160, bgcolor=white, splines=ortho, nodesep=0.38, ranksep=0.55];
  node [shape=box, fontname="Helvetica", fontsize=10, style="rounded,filled", color="#64748b",fillcolor="#f0f6fc"];
  edge [fontname="Helvetica", fontsize=8, color="#475569"];
  Student [label="Student / browser"];
  IO [label="IOManager\nvalidate answers"];
  AI [label="AIManager\nprompt + JSON schema"];
  Gemini [label="Gemini API\nstructured JSON", fillcolor="#fef3c7"];
  Logic [label="LogicManager\naudit + rules"];
  Data [label="DataManager\nprivacy + consent"];
  JSON [label="JSONStorage\natomic persistence",fillcolor="#dcfce7"];
  Result [label="Safe result\nin browser",fillcolor="#dcfce7"];
  Pending [label="AI failed:\npending / retry",fillcolor="#fee2e2"];
  Admin [label="Authorized admin"];
  Report [label="CohortReport\ncounts + mean",fillcolor="#dcfce7"];
  Student -> IO -> AI -> Gemini;
  Gemini -> Logic [label="validated"];
  Logic -> Data -> JSON;
  Logic -> Result -> Student;
  AI -> Pending [label="failure"];
  Pending -> Data;
  Admin -> Data;
  Data -> Report -> Admin [label="no IDs / text"];
}
